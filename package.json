{
  "name": "thumbnail-animator",
  "version": "1.11.3",
  "main": "main.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "electron .",
    "build": "npm run build:renderer && electron-builder",
    "build:win": "npm run build:renderer && electron-builder --win",
    "build:native": "cd native-scanner && npm run build",
    "build:native:ps": "powershell -Command \"cd native-scanner; npm run build\"",
    "build:mac": "npm run build:renderer && electron-builder --mac",
    "build:linux": "npm run build:renderer && electron-builder --linux",
    "dist": "npm run build:renderer && electron-builder --publish=never",
    "release": "npm run build:renderer && electron-builder --publish=always",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build:renderer": "node scripts/build-renderer.js",
    "build:renderer:dev": "node scripts/build-renderer.js --dev",
    "prestart": "node scripts/build-renderer.js",
    "typecheck": "tsc -p jsconfig.json"
  },
  "keywords": [
    "electron",
    "thumbnail",
    "media-browser",
    "image-viewer",
    "video-player",
    "desktop-app"
  ],
  "author": "Kevin Gundersen",
  "license": "ISC",
  "description": "Thumbnail Animator - a desktop media browser that animates thumbnails",
  "dependencies": {
    "@huggingface/transformers": "^4.0.1",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^3.6.0",
    "electron-updater": "^6.3.9",
    "exifreader": "^4.37.0",
    "image-size": "^2.0.2",
    "piscina": "^5.1.4",
    "png-chunks-extract": "^1.0.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.2",
    "better-sqlite3-test": "npm:better-sqlite3@^13.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.27.7",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "node-abi": "^4.36.0",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.2"
  },
  "build": {
    "appId": "com.thumbnailanimator.app",
    "productName": "Thumbnail Animator",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "kevinggundersen",
      "repo": "thumbnail-animator"
    },
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/@huggingface/transformers/node_modules/onnxruntime-node/**",
      "native-scanner/**/*.node",
      "native-scanner/index.js"
    ],
    "afterPack": "build/afterPack.js",
    "files": [
      "**/*",
      "!electron-cache/**/*",
      "!dist/**/*",
      "!*.md",
      "!native-scanner/src/**/*",
      "!native-scanner/target/**/*",
      "!native-scanner/Cargo.toml",
      "!native-scanner/Cargo.lock",
      "!native-scanner/build.rs",
      "!node_modules/@huggingface/transformers/.cache/**/*",
      "!**/onnxruntime-web/**",
      "!.claude/**",
      "!.cursor/**",
      "!test/**",
      "!scripts/**",
      "!types/**",
      "!jsconfig.json",
      "!eslint.config.js",
      "!vitest.config.js",
      "!dist-renderer/*.src.js",
      "!.editorconfig",
      "!.github/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.photography"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "Graphics"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Thumbnail-Animator-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    }
  }
}
